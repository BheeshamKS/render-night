    { "path": "devices", "a": ["GPU_0"], "b": ["GPU_0"], "expected_modified": false },
    { "path": "devices", "a": ["GPU_0"], "b": ["GPU_1"], "expected_modified": true },
    { "path": "camera", "a": null, "b": null, "expected_modified": false },
    { "path": "camera", "a": "Camera", "b": null, "expected_modified": true }
