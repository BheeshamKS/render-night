  "compute_diff_cases": [
    {
      "name": "returns empty object when values match defaults",
      "current": {
        "scene.render.resolution_x": 1920,
        "scene.render.resolution_y": 1080
      },
      "defaults": {
        "scene.render.resolution_x": 1920,
        "scene.render.resolution_y": 1080
      },
      "expected_diff": {}
    },
    {
      "name": "extracts only modified properties",
      "current": {
        "scene.render.resolution_x": 1920,
        "scene.render.resolution_y": 1080,
        "scene.cycles.samples": 256,
        "scene.render.image_settings.color_depth": "16"
      },
      "defaults": {
        "scene.render.resolution_x": 1280,
        "scene.render.resolution_y": 1080,
        "scene.cycles.samples": 128,
        "scene.render.image_settings.color_depth": "8"
      },
      "expected_diff": {
        "scene.render.resolution_x": 1920,
        "scene.cycles.samples": 256,
        "scene.render.image_settings.color_depth": "16"
      }
    }
  ],
  "engine_relevance_cases": [
    { "path": "scene.render.resolution_x", "engine": "CYCLES", "expected_relevant": true },
    { "path": "scene.render.resolution_x", "engine": "BLENDER_EEVEE_NEXT", "expected_relevant": true },
    { "path": "scene.render.image_settings.file_format", "engine": "BLENDER_WORKBENCH", "expected_relevant": true },
    { "path": "scene.view_settings.view_transform", "engine": "CYCLES", "expected_relevant": true },
    { "path": "scene.cycles.samples", "engine": "CYCLES", "expected_relevant": true },
    { "path": "scene.cycles.samples", "engine": "BLENDER_EEVEE_NEXT", "expected_relevant": false },
    { "path": "scene.cycles.adaptive_threshold", "engine": "BLENDER_EEVEE", "expected_relevant": false },
    { "path": "scene.cycles.denoiser", "engine": "BLENDER_WORKBENCH", "expected_relevant": false },
    { "path": "scene.eevee.taa_render_samples", "engine": "BLENDER_EEVEE_NEXT", "expected_relevant": true },
    { "path": "scene.eevee.taa_render_samples", "engine": "BLENDER_EEVEE", "expected_relevant": true },
    { "path": "scene.eevee.taa_render_samples", "engine": "CYCLES", "expected_relevant": false },
    { "path": "scene.eevee.use_bloom", "engine": "CYCLES", "expected_relevant": false }
