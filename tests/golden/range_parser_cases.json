  "invalid_cases": [
    {
      "input": "",
      "expected_error": "Empty frame expression"
    },
    {
      "input": "abc",
      "expected_error": "Invalid frame token"
    },
    {
      "input": "1-50, , 75",
      "expected_error": "Empty frame token in expression"
    },
    {
      "input": "1-10x0",
      "expected_error": "Step must be a positive integer"
    },
    {
      "input": "1-10x-2",
      "expected_error": "Step must be a positive integer"
    },
    {
      "input": "1-10-20",
      "expected_error": "Invalid frame token"
    }
  ],
  "mode_resolution_cases": [
    {
      "mode": "scene_default",
      "config": {
        "mode": "scene_default"
      },
      "scene_defaults": {
        "start": 1,
        "end": 250,
        "step": 1
      },
      "expected_total_count": 250,
      "expected_is_continuous": true
    },
    {
      "mode": "simple",
      "config": {
        "mode": "simple",
        "simple": {
          "start": 1,
          "end": 10,
          "step": 2
        }
      },
      "scene_defaults": {
        "start": 1,
        "end": 250,
        "step": 1
      },
      "expected_frames": [
        1,
        3,
        5,
        7,
        9
      ],
      "expected_total_count": 5,
      "expected_is_continuous": false
    },
    {
      "mode": "single_still",
      "config": {
        "mode": "single_still",
        "singleStillFrame": 42
      },
      "scene_defaults": {
        "start": 1,
        "end": 250,
        "step": 1
      },
      "expected_frames": [
        42
      ],
      "expected_total_count": 1,
      "expected_is_continuous": true
    }
  ],
  "video_validation_cases": [
    {
      "format": "FFMPEG",
      "is_video": true,
      "frames": [
        1,
        2,
        3,
        4,
        5
      ],
      "is_continuous": true,
      "total_count": 5,
      "expected_valid": true
    },
    {
      "format": "FFMPEG",
      "is_video": true,
      "frames": [
        1,
        3,
        5
      ],
      "is_continuous": false,
      "total_count": 3,
      "expected_valid": false,
      "expected_error": "Video formats require continuous sequential frames"
    },
    {
      "format": "FFMPEG",
      "is_video": true,
      "frames": [
        42
      ],
      "is_continuous": true,
      "total_count": 1,
      "expected_valid": false,
      "expected_error": "Single still frames cannot be rendered to a video container"
    },
    {
      "format": "PNG",
      "is_video": false,
      "frames": [
        1,
        5,
        10
      ],
      "is_continuous": false,
      "total_count": 3,
      "expected_valid": true
    }
  ]
}